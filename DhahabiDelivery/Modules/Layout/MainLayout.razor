@using Microsoft.AspNetCore.Authorization
@inherits DhahabiDelivery.Modules.Shared.ViewModelLayout<MainViewModel>
@attribute [Authorize]

<main class="size-full flex flex-col text-text">
    <div class="status-bar-safe-area"></div>
    @if (ViewModel.CargandoTasasDeCambio)
    {
        <div class="m-auto flex flex-col gap-4">
            <lottie-player
                src="/lottie/loading_exchange.json"
                background="transparent"
                speed="1"
                style="height: 170px;"
                class="m-auto"
                loop autoplay>
            </lottie-player>
            <h1 class="font-bold text-center text-xl m-auto">Cargando tasas de cambio...</h1>
        </div>
    }
    else if (ViewModel.ErrorTasasDeCambio)
    {
        <div class="flex-1 flex items-center justify-center bg-background p-4">
            <div class="max-w-md w-full bg-surface rounded-xl shadow-lg p-6 flex flex-col items-center gap-4">
                <lottie-player
                    src="/lottie/connection_error.json"
                    background="transparent"
                    speed="1"
                    style="height: 180px;"
                    loop
                    autoplay>
                </lottie-player>
                <div class="text-center">
                    <h2 class="font-bold text-xl text-gray-800 dark:text-gray-200 mb-2">Error de conexión</h2>
                    <p class="text-gray-600 dark:text-gray-400">No pudimos cargar las tasas de cambio. Por favor
                        verifica tu conexión a
                        internet e intenta nuevamente.</p>
                </div>
                <button
                    class="bg-gradient-to-r from-blue-500 to-indigo-600 text-white font-medium py-3 px-8 rounded-full shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 w-full"
                    @onclick="Reintentar">
                    Reintentar
                </button>
            </div>
        </div>
    }
    else
    {
        <article class="flex-1">
            @Body
        </article>
        <BottomBar/>
    }
</main>

@code {

    protected override async Task OnInitializedAsync()
    {
        ViewModel.InitializeAsync();
        await ViewModel.ObtenerTasasDeCambio();
    }

    private async Task Reintentar()
    {
        await ViewModel.ObtenerTasasDeCambio();
    }

}