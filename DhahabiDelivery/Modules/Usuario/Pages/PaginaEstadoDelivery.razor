@attribute [Route(Pages.DeliveryStatus)]
@using DhahabiDelivery.Modules.Entregas
@using DhahabiDelivery.Modules.Shared.Components
@inherits DhahabiDelivery.Modules.Shared.ViewModelComponent<DhahabiDelivery.Modules.Entregas.ViewModels.EntregasViewModel>
@inject NavigationManager Navigation

<div class="bg-background text-text animate-fadeIn">
    <!-- Contenido principal -->
    <div class="px-4 max-w-md mx-auto space-y-2">
        <!-- Selector de estado -->
        <div class="transform transition-all duration-300">
            <SelectorEstadoDelivery OnStatusChanged="OnDeliveryStatusChanged"/>
        </div>

        <!-- Información de estado actual -->
        <div class="bg-card-background rounded-lg overflow-hidden animate-slideInUp">
            <div class="p-3">
                <div class="flex justify-between items-center mb-2">
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
                             viewBox="0 0 16 16" class="text-primary">
                            <path
                                d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                        </svg>
                        <span class="font-medium">Estado Actual</span>
                    </div>
                    <span class="@GetStatusClass() px-3 py-1 rounded-full text-sm">
                        @GetStatusDisplayName()
                    </span>
                </div>

                <div class="flex justify-between items-center text-sm py-2 border-t border-divider">
                    <span class="text-text/70">Última actualización</span>
                    <span>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>

        <!-- Instrucciones de uso (desplegable) -->
        <div class="bg-primary/5 rounded-lg overflow-hidden animate-slideInUp delay-150">
            <div class="flex items-center gap-2 p-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                     viewBox="0 0 16 16" class="text-primary">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                    <path
                        d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z"/>
                </svg>
                <span class="font-medium">Instrucciones de Uso</span>
            </div>

            <div class="p-3 pt-0 text-sm space-y-2">
                <div class="flex gap-3 items-start py-1 animate-fadeIn">
                    <div class="rounded-full bg-green-100 dark:bg-green-900 p-1 mt-0.5">
                        <div class="w-2 h-2 rounded-full bg-green-500"></div>
                    </div>
                    <div>
                        <span class="font-medium text-primary">Disponible:</span>
                        <span>Activa el servicio de ubicación y te permite recibir órdenes de entrega.</span>
                    </div>
                </div>

                <div class="flex gap-3 items-start py-1 animate-fadeIn delay-100">
                    <div class="rounded-full bg-gray-100 dark:bg-gray-800 p-1 mt-0.5">
                        <div class="w-2 h-2 rounded-full bg-gray-500"></div>
                    </div>
                    <div>
                        <span class="font-medium text-primary">No Disponible:</span>
                        <span>Desactiva el servicio de ubicación y no recibirás nuevas órdenes.</span>
                    </div>
                </div>

                <div class="flex gap-3 items-start py-1 animate-fadeIn delay-200">
                    <div class="rounded-full bg-red-100 dark:bg-red-900 p-1 mt-0.5">
                        <div class="w-2 h-2 rounded-full bg-red-500"></div>
                    </div>
                    <div>
                        <span class="font-medium text-primary">Entregando:</span>
                        <span>Estado automático cuando inicias una entrega desde el mapa.</span>
                    </div>
                </div>

                <div class="flex gap-3 items-start py-1 animate-fadeIn delay-300">
                    <div class="rounded-full bg-orange-100 dark:bg-orange-900 p-1 mt-0.5">
                        <div class="w-2 h-2 rounded-full bg-orange-500"></div>
                    </div>
                    <div>
                        <span class="font-medium text-primary">Asignado:</span>
                        <span>Tienes una orden asignada pendiente de iniciar entrega.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    private async Task OnDeliveryStatusChanged(bool isAvailable)
    {
        try
        {
            StateHasChanged();

            // Optional: Show a toast notification
            Console.WriteLine($"📱 Estado del delivery cambiado: {(isAvailable ? "Disponible" : "No Disponible")}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error manejando cambio de estado: {ex.Message}");
        }
    }

    private string GetStatusDisplayName()
    {
        return ViewModel.State switch
        {
            ConstantesEstadoRepartidor.DISPONIBLE => "Disponible",
            ConstantesEstadoRepartidor.NO_DISPONIBLE => "No Disponible",
            ConstantesEstadoRepartidor.ENTREGANDO => "Entregando",
            ConstantesEstadoRepartidor.ASIGNADO => "Asignado",
            _ => "Desconocido"
        };
    }

    private string GetStatusClass()
    {
        return ViewModel.State switch
        {
            ConstantesEstadoRepartidor.DISPONIBLE => "text-green-600 bg-green-100 dark:bg-green-900/30 dark:text-green-900",
            ConstantesEstadoRepartidor.ENTREGANDO => "text-red-600 bg-red-100 dark:bg-red-900/30 dark:text-red-900",
            ConstantesEstadoRepartidor.ASIGNADO => "text-orange-600 bg-orange-100 dark:bg-orange-900/30 dark:text-orange-900",
            _ => "text-gray-600 bg-gray-100 dark:bg-gray-800 dark:text-gray-400"
        };
    }

}
