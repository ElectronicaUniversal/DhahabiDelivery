<div class="relative">
    <!-- Botón para abrir el selector de moneda -->
    <button @onclick="ToggleModal"
            class="flex items-center justify-between w-full px-4 py-3 bg-surface dark:bg-[#29292f] rounded-lg shadow-sm hover-hover transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-primary">
        @if (TasaSeleccionada != null)
        {
            <div class="flex items-center space-x-2">
                @if (!string.IsNullOrEmpty(TasaSeleccionada.ImagenPais))
                {
                    <img src="@TasaSeleccionada.ImagenPais" alt="@TasaSeleccionada.Pais"
                         class="w-5 h-5 rounded-full object-cover"/>
                }
                <span class="font-medium text-gray-800 dark:text-gray-300">@TasaSeleccionada.Nombre</span>
                <span class="text-xs text-gray-500 dark:text-gray-300">(@TasaSeleccionada.SimboloMoneda)</span>
            </div>
        }
        else
        {
            <span class="text-gray-500 dark:text-300">@Placeholder</span>
        }
        <svg xmlns="http://www.w3.org/2000/svg"
             class="h-5 w-5 text-gray-500 transform transition-transform duration-300 @(isModalOpen ? "rotate-180" : "")"
             fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
    </button>

    <!-- Modal de selección de moneda -->
    @if (isModalOpen)
    {
        <div class="fixed inset-0 bg-black/50 flex items-end justify-center z-50 @(isClosing ? "animate-fadeOut" : "animate-fadeIn")"
             @onclick="CloseModal">
            <div
                class="bg-background w-full max-w-md rounded-t-2xl shadow-xl max-h-[80vh] overflow-auto @(isClosing ? "animate-slideDown" : "animate-slideUp")"
                @onclick:stopPropagation>
                <div
                    class="sticky top-0 bg-background p-4 border-b border-gray-200 dark:border-gray-700 flex justify-between items-center">
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-300">Seleccionar moneda</h3>
                    <button @onclick="CloseModal" class="p-1 rounded-full hover:bg-hover transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-500" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>

                <div class="p-2 flex flex-col gap-1">
                    @foreach (var tasa in Tasas)
                    {
                        <div @onclick="() => SelectTasa(tasa)"
                             class="flex items-center p-3 rounded-lg cursor-pointer hover:bg-primary-light transition-colors duration-200
                                    @(TasaSeleccionada?.Codigo == tasa.Codigo ? "bg-primary-light" : "")">
                            <div class="flex items-center flex-1 space-x-3">
                                @if (!string.IsNullOrEmpty(tasa.ImagenPais))
                                {
                                    <img src="@tasa.ImagenPais" alt="@tasa.Pais"
                                         class="w-8 h-8 rounded-full object-cover border border-gray-200 dark:border-gray-700"/>
                                }
                                else
                                {
                                    <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center">
                                        <span
                                            class="text-xs font-medium">@(tasa.SimboloMoneda?.FirstOrDefault() ?? tasa.Codigo?.FirstOrDefault())</span>
                                    </div>
                                }
                                <div>
                                    <div class="font-medium text-gray-800 dark:text-gray-300">@tasa.Nombre</div>
                                    <div class="flex text-xs text-gray-500 dark:text-gray-400 space-x-1">
                                        <span>@tasa.Codigo</span>
                                        @if (!string.IsNullOrEmpty(tasa.Pais))
                                        {
                                            <span>•</span>
                                            <span>@tasa.Pais</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div
                                class="text-lg font-semibold text-gray-700 dark:text-gray-300">@tasa.SimboloMoneda</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
