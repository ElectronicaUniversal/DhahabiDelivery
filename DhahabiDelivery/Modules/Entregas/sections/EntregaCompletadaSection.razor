@using GoogleMapsComponents
@using GoogleMapsComponents.Maps
@inherits DhahabiDelivery.Modules.Shared.ViewModelComponent<DhahabiDelivery.Modules.Entregas.ViewModels.EntregasViewModel>

<Dialog @ref="_dialogRef" Title="Finalizar Entrega" Content="¿Estás seguro de finalizar esta entrega?" Accept="FinalizarEntrega"></Dialog>
<section class="size-full bg-surface flex items-center flex-col justify-center">
    <section class="flex-1">
        <AdvancedGoogleMap Height="100%" Id="map1" Options="@ViewModel.MapOptions" OnAfterInit="AfterMapRender">
            <MarkerComponent Lat="@ViewModel.Marker.Lat" Lng="@ViewModel.Marker.Lng">
                <div class="location-svg">
                    <LocationSvg Url="/imagenes/profile.svg"/>
                </div>
            </MarkerComponent>
        </AdvancedGoogleMap>
        <button @onclick="ShowFinalizarEntregaDialog" class="absolute top-2 right-2 bg-primary hover:bg-primary/90 pointer text-white rounded-md px-6 py-1">
            Finalizar Entrega
        </button>
    </section>
    <MainSection/>
</section>

@code {
    private Dialog _dialogRef;

    private async Task ShowFinalizarEntregaDialog()
    {
        await _dialogRef.Open();
    }

    private async Task FinalizarEntrega()
    {
        await ViewModel.FinalizarEntrega();
    }

    private async Task AfterMapRender()
    {
        ViewModel.LoadingMap = false;
        ViewModel.Marker = ViewModel.MapOptions.Center;
    }

}