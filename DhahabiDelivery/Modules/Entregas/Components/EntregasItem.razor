@using DhahabiDelivery.Modules.Shared.Components
@using Mensajeria
<div role="listitem" class="shadow cursor-pointer rounded-md bg-card-background entrega-item @DelayClass">
    <NavLink href="@_link" class="p-3 flex gap-2">
        <div class="flex flex-col items-center gap-2">
            <img alt="profile" class="size-10 rounded-full bg-gray-400"
                 src="data:image/jpeg;base64,"/>
            <span class="text-[11px] w-fit rounded-full text-white px-2  bg-orange-400">@Item.EstadoEnvio</span>
        </div>
        <div class="flex flex-col">
            <h4 class="font-bold text-purple-400">@Item.NombreCliente</h4>
            <span class="text-[12px] text-gray-500">Cantidad: @Item.Productos.Length</span>
            @if (Item.MetodoPago == "CASH")
            {
                <div class="flex items-center gap-1 mt-1">
                    <span class="text-[12px] text-gray-500">Método de pago: <span
                            class="font-semibold text-lime-600">Efectivo</span></span>
                </div>
            }
            else
            {
                <span class="text-[12px] text-gray-500">Método: @Item.MetodoPago</span>
            }
        </div>

        <div class="ml-auto flex flex-col">
            <span class="text-[12px] text-gray-400 ml-auto"># @Item.Id</span>
            <h3 class="mt-auto text-orange-400 font-bold text-xl text-right">
                <PriceContainer Moneda="@Item.CodigoMoneda" Price="Item.Total"/>
            </h3>
        </div>
    </NavLink>
</div>

@code {
    [Parameter] public required EntregaResumen Item { get; set; }
    [Parameter] public int Index { get; set; }
    private string _link = string.Empty;
    private string DelayClass => $"entrega-delay-{Math.Min(Index, 9)}";

    protected override void OnParametersSet()
    {
        _link = $"{Pages.EntregasDetail}/{Item.Id}";
    }

}