<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DhahabiDelivery.CameraPage"
             xmlns:controls="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             BackgroundColor="Black"
             Title="Escanear QR">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <StackLayout Grid.Row="0" Padding="20,30,20,10">
            <Label Text="Escanea el código QR"
                   TextColor="White"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="Centra el código QR en el recuadro"
                   TextColor="LightGray"
                   FontSize="14"
                   HorizontalOptions="Center" />
        </StackLayout>

        <!-- Scanner View -->
        <controls:CameraBarcodeReaderView
            Grid.Row="1"
            x:Name="CameraBarcodeReaderView"
            BarcodesDetected="BarcodesDetected"
            VerticalOptions="FillAndExpand"
            HorizontalOptions="FillAndExpand" />

        <!-- Bottom Controls -->
        <Button Grid.Row="2"
                Text="Cancelar"
                Clicked="CancelButton_Clicked"
                BackgroundColor="#4B0082"
                TextColor="White"
                CornerRadius="20"
                Margin="40,10,40,30"
                HeightRequest="50" />
    </Grid>
</ContentPage>